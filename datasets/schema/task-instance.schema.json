{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0xnicholas/tokencamp-benchmarks/datasets/schema/task-instance.schema.json",
  "title": "Task Instance",
  "description": "One line of datasets/<task_type>/<seed>/instances.jsonl: the frozen Task Instance envelope of ADR-0003 (amended by ADR-0007). Validated in CI by src/core/datasets.ts, which is authoritative for the same shape.",
  "type": "object",
  "required": [
    "id",
    "task_type",
    "seed",
    "initial_state",
    "expected_outcome",
    "verifier",
    "difficulty",
    "contamination"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable, unique within the file: <seed>-<upstream identifier>."
    },
    "task_type": {
      "enum": ["code_generation", "corpus_qa", "structured_extraction", "agentic_repo_task"]
    },
    "seed": { "$ref": "#/$defs/seed" },
    "initial_state": { "type": "object" },
    "expected_outcome": { "type": "object" },
    "verifier": { "$ref": "#/$defs/verifier" },
    "difficulty": {
      "description": "null before the Calibration Run; the run fills the record (ADR-0003).",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/difficulty" }]
    },
    "contamination": {
      "type": "object",
      "required": ["disclosed", "notes"],
      "additionalProperties": false,
      "properties": {
        "disclosed": { "const": true },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "task_type": { "const": "code_generation" } } },
      "then": {
        "properties": {
          "initial_state": { "$ref": "#/$defs/codegenInitialState" },
          "expected_outcome": { "$ref": "#/$defs/codegenExpectedOutcome" },
          "verifier": {
            "properties": {
              "name": { "const": "mbpp_unit_tests" },
              "params": { "const": { "image": "python:3.12-slim", "network": false, "per_test_timeout_s": 10, "total_timeout_s": 30 } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task_type": { "const": "corpus_qa" } } },
      "then": {
        "properties": {
          "initial_state": { "$ref": "#/$defs/corpusQaInitialState" },
          "expected_outcome": { "$ref": "#/$defs/corpusQaExpectedOutcome" },
          "verifier": {
            "properties": {
              "name": { "const": "drop_em_f1" },
              "params": { "const": { "normalization": "drop-canonical" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task_type": { "const": "structured_extraction" } } },
      "then": {
        "properties": {
          "initial_state": { "$ref": "#/$defs/extractionInitialState" },
          "expected_outcome": { "$ref": "#/$defs/extractionExpectedOutcome" },
          "verifier": {
            "properties": {
              "name": { "const": "golden_fields_exact" },
              "params": { "const": { "trim": true, "case_sensitive": true, "extra_keys": "ignored" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "task_type": { "const": "agentic_repo_task" } } },
      "then": {
        "properties": {
          "initial_state": { "$ref": "#/$defs/agenticInitialState" },
          "expected_outcome": { "$ref": "#/$defs/agenticExpectedOutcome" },
          "verifier": {
            "properties": {
              "name": { "const": "swebench_test_suite" },
              "params": { "const": { "per_test_timeout_s": 120, "total_timeout_s": 1800 } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "seed": {
      "type": "object",
      "required": ["name", "version", "license", "source_url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "description": "Pinned upstream revision (commit / dataset revision)." },
        "license": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "minLength": 1 }
      }
    },
    "verifier": {
      "type": "object",
      "required": ["name", "params"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["mbpp_unit_tests", "golden_fields_exact", "drop_em_f1", "swebench_test_suite"] },
        "params": { "type": "object", "description": "Pointer only — semantics live in ADR-0005 and the Evaluation Engine." }
      }
    },
    "difficulty": {
      "type": "object",
      "required": ["tier", "baseline_pass_rate", "calibrated_at"],
      "additionalProperties": false,
      "properties": {
        "tier": { "enum": ["easy", "medium", "hard"] },
        "baseline_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibrated_at": { "type": "string", "minLength": 1 }
      }
    },
    "codegenInitialState": {
      "type": "object",
      "required": ["prompt", "entry_point", "function_signature", "test_setup_code"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "entry_point": { "type": "string", "minLength": 1 },
        "function_signature": { "type": "string", "minLength": 1 },
        "test_setup_code": { "type": "string" }
      }
    },
    "codegenExpectedOutcome": {
      "type": "object",
      "required": ["tests", "entry_point"],
      "additionalProperties": false,
      "properties": {
        "tests": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "entry_point": { "type": "string", "minLength": 1 }
      }
    },
    "corpusQaInitialState": {
      "type": "object",
      "required": ["passage", "question"],
      "additionalProperties": false,
      "properties": {
        "passage": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 }
      }
    },
    "corpusQaExpectedOutcome": {
      "type": "object",
      "required": ["answers", "validated_answers", "answer_types"],
      "additionalProperties": false,
      "properties": {
        "answers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "validated_answers": {
          "type": "array",
          "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "answer_types": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["span", "number", "date"] }
        }
      }
    },
    "extractionInitialState": {
      "type": "object",
      "required": ["document", "keys"],
      "additionalProperties": false,
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "extractionExpectedOutcome": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "agenticInitialState": {
      "type": "object",
      "required": ["image", "repo", "base_commit", "problem_statement"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "required": ["tags", "digests", "digest_status"],
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "object",
              "required": ["x86_64", "arm64"],
              "additionalProperties": false,
              "properties": {
                "x86_64": { "type": "string", "minLength": 1 },
                "arm64": { "type": "string", "minLength": 1 }
              }
            },
            "digests": {
              "type": "object",
              "required": ["x86_64", "arm64"],
              "additionalProperties": false,
              "properties": {
                "x86_64": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
                "arm64": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] }
              },
              "description": "Manifest digests per architecture; null until `--pin-digests` reaches a registry (ADR-0007 asks for tag@digest)."
            },
            "digest_status": { "enum": ["pinned", "unpinned"] }
          }
        },
        "repo": { "type": "string", "minLength": 1 },
        "base_commit": { "type": "string", "minLength": 1 },
        "problem_statement": { "type": "string", "minLength": 1 }
      }
    },
    "agenticExpectedOutcome": {
      "type": "object",
      "required": ["test_patch", "fail_to_pass", "pass_to_pass"],
      "additionalProperties": false,
      "properties": {
        "test_patch": { "type": "string", "minLength": 1 },
        "fail_to_pass": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "pass_to_pass": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "May be empty: 6 Lite instances define no regression tests." }
      }
    }
  }
}
